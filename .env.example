# .env.example —— 复制为 .env 后填写，.env 不提交
OPSAGENT_LLM_API_KEY=
OPSAGENT_NACOS_USERNAME=nacos
OPSAGENT_NACOS_PASSWORD=
OPSAGENT_MOCK_SCENARIO=b_pay_slow
# 模型默认 deepseek-v4.1-flash；结构化输出：function_calling 可用（默认）；json_schema 不可用（模型把 JSON 包在 ```json 代码块里）
OPSAGENT_LLM_STRUCTURED_METHOD=function_calling
# 思考模式默认关闭（更快）；处理复杂问题时设为 true
# OPSAGENT_LLM_THINKING=false
# 透传给模型接口的额外参数（JSON），与 thinking 合并，同名键以这里为准
# OPSAGENT_LLM_EXTRA_BODY={}
